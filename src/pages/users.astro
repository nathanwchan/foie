---
import BaseLayout from "../layouts/BaseLayout.astro";
import CollectionHero from "../components/CollectionHero.astro";
import UserCard from "../components/UserCard.astro";
import { getResources, getUsers } from "../lib/content";

const users = await getUsers();
const resources = await getResources();
const usersWithResources = users
  .map((user) => ({
    user,
    resources: resources.filter((resource) => resource.data.userIds.includes(user.data.id))
  }))
  .sort((left, right) =>
    right.resources.length - left.resources.length
    || left.user.data.name.localeCompare(right.user.data.name)
  );
---

<BaseLayout
  title="Users"
  description="A manually curated directory of people working at the intersection of AI and iOS engineering, with links to their profiles and related posts."
  canonicalPath="/users"
>
  <CollectionHero variant="users" />

  <section class="users-section shell" data-pagefind-body>
    <div class="users-heading">
      <p>{users.length} people</p>
    </div>
    <div class="users-list">
      {usersWithResources.map(({ user, resources }) => (
        <UserCard
          user={user}
          resources={resources}
        />
      ))}
    </div>
  </section>
</BaseLayout>
