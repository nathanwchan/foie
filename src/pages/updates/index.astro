---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { displayDate, getResources, getUpdates } from "../../lib/content";

const updates = await getUpdates();
const resources = await getResources();
---

<BaseLayout title="Weekly signal" description="A chronological archive of the newest developments in AI-enabled iOS engineering.">
  <section class="page-intro shell">
    <p class="eyebrow">Weekly signal</p>
    <h1>The field, week by week.</h1>
    <p>Each edition connects new sources to the durable questions facing native software teams.</p>
    <span class="chronology-note">Newest update first</span>
  </section>
  <section class="section-tight shell">
    <div class="update-list">
      {updates.map((update) => (
        <a class="update-link" href={`/updates/${update.data.id}/`}>
          <time datetime={update.data.date.toISOString()}>{displayDate(update.data.date)}</time>
          <div><h2>{update.data.headline}</h2><p>{update.data.resourceIds.length} resources · {update.data.emergingTopics.length} emerging themes</p></div>
          <span class="arrow" aria-hidden="true">→</span>
        </a>
      ))}
    </div>
    <p class="chronology-note">The current collection contains {resources.length} resources</p>
  </section>
</BaseLayout>
