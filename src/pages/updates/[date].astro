---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ResourceCard from "../../components/ResourceCard.astro";
import { displayDate, getResources, getUpdates, resourceMap } from "../../lib/content";
import { topicLabels } from "../../lib/taxonomy";

export async function getStaticPaths() {
  const updates = await getUpdates();
  return updates.map((update) => ({ params: { date: update.data.id }, props: { update } }));
}
const { update } = Astro.props;
const resources = await getResources();
const byId = resourceMap(resources);
const included = update.data.resourceIds.map((id) => byId.get(id)).filter(Boolean);
---

<BaseLayout title={update.data.headline} description={update.data.synthesis} canonicalPath={`/updates/${update.data.id}/`}>
  <header class="detail-hero detail-shell">
    <p class="eyebrow">Weekly signal</p>
    <div class="detail-kicker"><time datetime={update.data.date.toISOString()}>{displayDate(update.data.date)}</time><span>•</span><span>{included.length} resources</span></div>
    <h1>{update.data.headline}</h1>
  </header>
  <article class="detail-content detail-shell prose">
    <p class="detail-summary">{update.data.synthesis}</p>
    <h2>Emerging themes</h2>
    <div class="signal-topics">{update.data.emergingTopics.map((topic) => <span>{topicLabels[topic]}</span>)}</div>
  </article>
  <section class="section-tight shell">
    <div class="section-heading"><div><p class="eyebrow">In this edition</p><h2>Newest to oldest</h2></div></div>
    <div class="resource-grid">{included.map((resource) => resource && <ResourceCard resource={resource} />)}</div>
  </section>
</BaseLayout>
