---
import BaseLayout from "../layouts/BaseLayout.astro";
import FilterBar from "../components/FilterBar.astro";
import ResourceCard from "../components/ResourceCard.astro";
import { getResources } from "../lib/content";

const resources = await getResources();
const feed = resources;
const initialTopic = Astro.url.searchParams.get("topic") ?? "";
---

<BaseLayout>
  <section class="home-hero shell">
    <div>
      <p class="eyebrow">Intelligence for native software teams</p>
      <h1 class="display">The future of iOS engineering, <span class="gradient-text">as it unfolds</span></h1>
      <p class="lede">One place to follow the tools, workflows, and real-world lessons shaping AI-assisted iOS development.</p>
    </div>
  </section>

  <section class="feed-section shell">
    <div class="feed-layout">
      <div class="feed-main">
        <div class="feed-heading">
          <div><h2>Latest signals</h2></div>
        </div>
        <FilterBar resources={resources} />
        <div class="feed-list resource-grid" id="resource-results" data-pagefind-body>
          {feed.map((resource) => <ResourceCard resource={resource} />)}
        </div>
        <div id="empty-state" class="empty-state" hidden>
          <h2>No signals match those filters.</h2>
          <p>Try a broader topic or clear the current search.</p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script is:inline define:vars={{ initialTopic }}>
  if (initialTopic) {
    const topic = document.querySelector("#topic-filter");
    if (topic) {
      topic.value = initialTopic;
      topic.dispatchEvent(new Event("change"));
    }
  }
</script>
