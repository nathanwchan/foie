---
import BaseLayout from "../layouts/BaseLayout.astro";
import CollectionHero from "../components/CollectionHero.astro";
import FilterBar from "../components/FilterBar.astro";
import ResourceCard from "../components/ResourceCard.astro";
import { getResources } from "../lib/content";
import { execFileSync } from "node:child_process";

const resources = await getResources();
const feed = resources;
let updatedAt = new Date();
try {
  const commitDate = execFileSync("git", ["log", "-1", "--format=%cI"], { encoding: "utf8" }).trim();
  if (commitDate) updatedAt = new Date(commitDate);
} catch {
  // Static hosts without Git metadata fall back to the build time.
}
const updatedAtIso = updatedAt.toISOString();
const updatedDate = new Intl.DateTimeFormat("en-US", { month: "short", day: "numeric", year: "numeric", timeZone: "America/Los_Angeles" }).format(updatedAt);
const updatedTime = new Intl.DateTimeFormat("en-US", { hour: "numeric", minute: "2-digit", hour12: true, timeZone: "America/Los_Angeles" }).format(updatedAt).replace(" ", "").toLowerCase();
const updatedLabel = `${updatedDate} ${updatedTime}`;
---

<BaseLayout>
  <CollectionHero />

  <section class="feed-section shell">
    <div class="feed-layout">
      <div class="feed-main">
        <div class="feed-heading">
          <p class="chronology-label"><span aria-hidden="true">↓</span> Newest first</p>
          <p class="last-updated" data-last-updated data-updated-at={updatedAtIso} data-updated-label={updatedLabel}>last updated {updatedLabel}</p>
        </div>
        <FilterBar resources={resources} />
        <div class="feed-list resource-grid" id="resource-results" data-pagefind-body>
          {feed.map((resource) => <ResourceCard resource={resource} />)}
        </div>
        <div id="empty-state" class="empty-state" hidden>
          <h2>No posts match that search.</h2>
          <p>Try another keyword or clear the search.</p>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  const updated = document.querySelector<HTMLElement>("[data-last-updated]");
  // v2 replaces the original key, whose first-run baseline incorrectly marked every post as seen.
  const seenResourcesStorageKey = "foie:seen-resource-slugs:v2";

  function initializeNewResourceBadges() {
    const cards = Array.from(document.querySelectorAll<HTMLElement>("[data-resource-card]"));
    const feed = document.querySelector<HTMLElement>("#resource-results");

    try {
      const storedSlugs = window.localStorage.getItem(seenResourcesStorageKey);
      const parsedSlugs: unknown = storedSlugs === null ? [] : JSON.parse(storedSlugs);
      const seenSlugs = new Set(Array.isArray(parsedSlugs) ? parsedSlugs.filter((slug): slug is string => typeof slug === "string") : []);
      const unseenCards = cards.filter((card) => {
        const slug = card.dataset.slug;
        if (!slug || seenSlugs.has(slug)) return false;
        card.querySelector<HTMLElement>("[data-new-badge]")?.removeAttribute("hidden");
        return true;
      });
      const unseenCardSet = new Set(unseenCards);
      const seenCards = cards.filter((card) => !unseenCardSet.has(card));

      // The server-rendered order is already newest-first, so this stable partition
      // preserves publication order inside both the unseen and seen groups.
      feed?.append(...unseenCards, ...seenCards);

      const markSeen = (card: HTMLElement) => {
        const slug = card.dataset.slug;
        if (!slug || seenSlugs.has(slug)) return;
        seenSlugs.add(slug);
        window.localStorage.setItem(seenResourcesStorageKey, JSON.stringify([...seenSlugs]));
      };

      if (!("IntersectionObserver" in window)) {
        unseenCards.forEach((card) => card.addEventListener("click", () => markSeen(card), { once: true }));
        return;
      }

      const observer = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting || entry.intersectionRatio < 0.5) return;
          const card = entry.target as HTMLElement;
          markSeen(card);
          observer.unobserve(card);
        });
      }, { threshold: 0.5 });

      unseenCards.forEach((card) => observer.observe(card));
    } catch {
      // Storage can be unavailable in privacy modes; the feed still works without badges.
    }
  }

  function relativeAge(date: Date) {
    const minutes = Math.max(0, Math.floor((Date.now() - date.getTime()) / 60_000));
    if (minutes < 1) return "just now";
    if (minutes === 1) return "1 minute ago";
    if (minutes < 60) return `${minutes} minutes ago`;
    const hours = Math.floor(minutes / 60);
    if (hours === 1) return "1 hour ago";
    if (hours < 24) return `${hours} hours ago`;
    const days = Math.floor(hours / 24);
    return days === 1 ? "1 day ago" : `${days} days ago`;
  }

  function updateRelativeAge() {
    const iso = updated?.dataset.updatedAt;
    const label = updated?.dataset.updatedLabel;
    if (!updated || !iso || !label) return;
    updated.textContent = `last updated ${label} (${relativeAge(new Date(iso))})`;
  }

  updateRelativeAge();
  window.setInterval(updateRelativeAge, 60_000);
  initializeNewResourceBadges();
</script>
