---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ResourceCard from "../../components/ResourceCard.astro";
import ResourcePreview from "../../components/ResourcePreview.astro";
import { displayDate, getResources, hostName } from "../../lib/content";
import { evidenceLabels, formatLabels, topicLabels } from "../../lib/taxonomy";

export async function getStaticPaths() {
  const resources = await getResources();
  return resources.map((resource) => ({ params: { slug: resource.data.slug }, props: { resource, resources } }));
}

const { resource, resources } = Astro.props;
const { data } = resource;
const related = resources
  .filter((candidate) => candidate.data.id !== data.id && (data.relatedResourceIds.includes(candidate.data.id) || candidate.data.topics.some((topic) => data.topics.includes(topic))))
  .sort((a, b) => {
    const aExplicit = data.relatedResourceIds.indexOf(a.data.id);
    const bExplicit = data.relatedResourceIds.indexOf(b.data.id);
    if (aExplicit >= 0 || bExplicit >= 0) return (aExplicit < 0 ? 999 : aExplicit) - (bExplicit < 0 ? 999 : bExplicit);
    return (b.data.publishedAt ?? b.data.discoveredAt).getTime() - (a.data.publishedAt ?? a.data.discoveredAt).getTime();
  })
  .slice(0, 3);
const sortDate = data.publishedAt ?? data.discoveredAt;
---

<BaseLayout title={data.title} description={data.summary} canonicalPath={`/resources/${data.slug}/`}>
  <article>
    <header class="detail-hero detail-shell" data-pagefind-body data-pagefind-meta={`format:${data.format}`}>
      <div class="detail-kicker">
        <span class={`evidence evidence-${data.evidenceType}`}>{evidenceLabels[data.evidenceType]}</span>
        <span>{formatLabels[data.format]}</span><span>•</span>
        <time datetime={sortDate.toISOString()}>{displayDate(sortDate)}</time>
      </div>
      <h1 data-pagefind-meta="title">{data.title}</h1>
      <p class="detail-authors">By {data.authors.map((author, index) => (
        <>{author.url ? <a href={author.url} target="_blank" rel="noreferrer">{author.name}</a> : author.name}{index < data.authors.length - 1 ? ", " : ""}</>
      ))} · {data.publisher}</p>
      <ResourcePreview resource={resource} large />
      {data.topics.map((topic) => <span hidden data-pagefind-filter={`topic:${topicLabels[topic]}`}>{topicLabels[topic]}</span>)}
      <span hidden data-pagefind-filter={`evidence:${evidenceLabels[data.evidenceType]}`}></span>
      <span hidden data-pagefind-filter={`format:${formatLabels[data.format]}`}></span>
    </header>
    <div class="detail-content detail-shell" data-pagefind-body>
      <p class="detail-summary">{data.summary}</p>
      <div class="takeaway-box"><span>What to do with this</span><p>{data.takeaway}</p></div>
      <dl class="detail-grid">
        <div class="detail-fact"><dt>Source</dt><dd>{hostName(data.canonicalUrl)}</dd></div>
        <div class="detail-fact"><dt>Verified</dt><dd>{displayDate(data.lastVerifiedAt)}</dd></div>
        <div class="detail-fact"><dt>Evidence</dt><dd>{evidenceLabels[data.evidenceType]}</dd></div>
        <div class="detail-fact"><dt>Availability</dt><dd>{data.availability === "available" ? "Available" : data.availability}</dd></div>
      </dl>
      <div class="signal-topics">{data.topics.map((topic) => <span>{topicLabels[topic]}</span>)}</div>
      <div class="source-actions">
        <a class="button button-primary" href={data.canonicalUrl} target="_blank" rel="noreferrer">Open original <span aria-hidden="true">↗</span></a>
        {data.alternateUrls.map((url) => <a class="button button-secondary" href={url} target="_blank" rel="noreferrer">Alternate source ↗</a>)}
      </div>
    </div>
  </article>
  {related.length > 0 && (
    <section class="section related shell">
      <div class="section-heading"><div><p class="eyebrow">Keep exploring</p><h2>Related signals</h2></div></div>
      <div class="resource-grid">{related.map((item) => <ResourceCard resource={item} />)}</div>
    </section>
  )}
</BaseLayout>
