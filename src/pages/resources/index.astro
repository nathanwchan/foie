---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ResourceCard from "../../components/ResourceCard.astro";
import FilterBar from "../../components/FilterBar.astro";
import { getResources } from "../../lib/content";

const resources = await getResources();
const initialTopic = Astro.url.searchParams.get("topic") ?? "";
---

<BaseLayout title="Resource library" description="Search articles, talks, papers, tools, and production case studies about AI-enabled iOS engineering.">
  <section class="page-intro shell">
    <p class="eyebrow">The index</p>
    <h1>Signals worth keeping.</h1>
    <p>Production experience, platform direction, empirical research, and practitioner detail—curated for teams that need more than agent demos.</p>
    <span class="chronology-note">Newest first, continuously ordered toward older work</span>
  </section>
  <section class="section-tight shell">
    <FilterBar resources={resources} />
    <div class="library-feed" id="resource-results">
      {resources.map((resource, index) => <ResourceCard resource={resource} rank={index + 1} featured={index === 0} />)}
    </div>
    <div id="empty-state" class="empty-state" hidden>
      <h2>No signals match those filters.</h2>
      <p>Try a broader topic or clear the current search.</p>
    </div>
  </section>
</BaseLayout>

<script is:inline define:vars={{ initialTopic }}>
  if (initialTopic) {
    const topic = document.querySelector("#topic-filter");
    if (topic) {
      topic.value = initialTopic;
      topic.dispatchEvent(new Event("change"));
    }
  }
</script>
