---
import type { ResourceEntry } from "../lib/content";

interface Props {
  resource: ResourceEntry;
}

const { resource } = Astro.props;
const { data } = resource;
const media = data.media;
---

<div class:list={["resource-media", `resource-media-${media.type}`]}>
  {media.type === "youtube" && (
    <iframe
      src={`https://www.youtube-nocookie.com/embed/${media.videoId}?rel=0`}
      title={media.title}
      loading="lazy"
      referrerpolicy="strict-origin-when-cross-origin"
      allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
      allowfullscreen
    ></iframe>
  )}
  {media.type === "video" && (
    <video controls preload="none" poster={media.posterUrl} aria-label={media.title}>
      <source src={media.url} type="video/mp4" />
      <a href={data.canonicalUrl} target="_blank" rel="noreferrer">Watch {data.title} at the source</a>
    </video>
  )}
  {media.type === "x" && (
    <div class="x-native-player" data-x-native-player>
      <video preload="metadata" poster={media.posterUrl} playsinline aria-label={media.title}>
        <source src={media.videoUrl} type="video/mp4" />
        <a href={data.canonicalUrl} target="_blank" rel="noreferrer">Watch {data.title} on X</a>
      </video>
      <button class="x-video-trigger" type="button" data-x-video-trigger aria-label={`Play ${media.title}`}>
        <span class="x-video-play" aria-hidden="true"><span></span></span>
      </button>
    </div>
  )}
  {media.type === "image" && (
    <a href={data.canonicalUrl} target="_blank" rel="noreferrer" aria-label={`Open ${data.title} on ${data.publisher}`}>
      <img src={media.url} alt={media.alt} loading="lazy" decoding="async" />
    </a>
  )}
</div>

<script>
  document.addEventListener("click", async (event) => {
    if (!(event.target instanceof Element)) return;
    const trigger = event.target.closest<HTMLButtonElement>("[data-x-video-trigger]");
    if (!trigger) return;

    const player = trigger.closest<HTMLElement>("[data-x-native-player]");
    const video = player?.querySelector<HTMLVideoElement>("video");
    if (!player || !video) return;

    video.controls = true;
    trigger.hidden = true;
    try {
      await video.play();
    } catch {
      player.classList.add("x-video-unavailable");
      trigger.hidden = false;
      trigger.setAttribute("aria-label", "Video unavailable; open the source on X");
    }
  });
</script>
