---
import CollectionNav from "./CollectionNav.astro";

interface Props {
  variant?: "posts" | "users";
}

const { variant = "posts" } = Astro.props;
const isUsers = variant === "users";
---

<section class="home-hero shell">
  <div>
    <h1 class="display" data-header-reveal-after>
      <span class="display-line display-primary">{isUsers ? "The people shaping" : "The future of iOS engineering,"}</span>
      <span class="display-line gradient-text">{isUsers ? "what comes next" : "as it unfolds"}</span>
    </h1>
    <p class="lede">
      {isUsers ? "A curated directory of people pushing iOS engineering forward with AI." : "What it means to be an iOS engineer is changing in real time."}<br />
      {isUsers ? "Follow their ideas and explore what they’re building." : "Follow the tools, ideas, and thought leaders defining what comes next."}
    </p>
    <CollectionNav />
  </div>
</section>
