---
import type { ResourceEntry } from "../lib/content";
import { displayDate, hostName } from "../lib/content";
import { topicLabels } from "../lib/taxonomy";
import FormatBadge from "./FormatBadge.astro";
import ResourceMedia from "./ResourceMedia.astro";

interface Props {
  resource: ResourceEntry;
}

const { resource } = Astro.props;
const { data } = resource;
const sortDate = data.publishedAt ?? data.discoveredAt;
const year = sortDate.getUTCFullYear().toString();
---

<article
  class="resource-card"
  id={`resource-${data.slug}`}
  data-resource-card
  data-slug={data.slug}
  data-format={data.format}
  data-publisher={data.publisher}
  data-year={year}
  data-topics={data.topics.join(" ")}
  data-search={`${data.title} ${data.publisher} ${data.authors.map((author) => author.name).join(" ")} ${data.summary} ${data.takeaway} ${data.topics.map((topic) => topicLabels[topic]).join(" ")}`.toLowerCase()}
>
  <div class="card-link">
    <div class="card-copy">
      <div class="card-topline">
        <FormatBadge resource={resource} />
        <span class="dot">•</span>
        <time datetime={sortDate.toISOString()}>{displayDate(sortDate)}</time>
      </div>
      <h3><a href={data.canonicalUrl} target="_blank" rel="noreferrer">{data.title} <span aria-hidden="true">↗</span></a></h3>
      <p class="card-summary">{data.summary}</p>
      <div class="card-takeaway">
        <strong>Practical takeaway</strong>
        <p>{data.takeaway}</p>
      </div>
      <p class="card-byline">By <a href={data.publisherUrl ?? data.canonicalUrl} target="_blank" rel="noreferrer">{data.publisher}</a></p>
      {data.alternateUrls.length > 0 && (
        <p class="alternate-sources">Alternate versions: {data.alternateUrls.map((url, index) => (
          <><a href={url} target="_blank" rel="noreferrer">{hostName(url)} ↗</a>{index < data.alternateUrls.length - 1 ? ", " : ""}</>
        ))}</p>
      )}
    </div>
    {data.media && (
      <div class="card-media">
        <ResourceMedia resource={resource} />
      </div>
    )}
  </div>
</article>
