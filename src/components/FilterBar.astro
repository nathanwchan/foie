---
import { Search } from "@lucide/astro";
import type { ResourceEntry } from "../lib/content";

interface Props { resources: ResourceEntry[] }
const { resources } = Astro.props;
const keywords = ["Agents", "Xcode", "Testing", "SwiftUI"];
---

<section class="filter-panel" aria-label="Search resources">
  <p class="filter-label">Search the collection</p>
  <div class="filter-row">
    <div class="search-input-wrap">
      <Search class="search-icon" size={20} stroke-width={2.2} aria-hidden="true" />
      <input id="resource-search" type="search" placeholder="Search resources" autocomplete="off" aria-label="Search resources" />
    </div>
    <div class="keyword-chips" aria-label="Common searches">
      {keywords.map((keyword) => <button class="keyword-chip" type="button" data-keyword={keyword} aria-pressed="false">{keyword}</button>)}
    </div>
  </div>
  <p class="filter-status" aria-live="polite"><strong id="result-count">{resources.length}</strong> resources</p>
</section>

<script>
  const search = document.querySelector<HTMLInputElement>("#resource-search");
  const chips = [...document.querySelectorAll<HTMLButtonElement>("[data-keyword]")];
  const cards = [...document.querySelectorAll<HTMLElement>("[data-resource-card]")];
  const count = document.querySelector<HTMLElement>("#result-count");
  const empty = document.querySelector<HTMLElement>("#empty-state");
  let pagefindMatches: Set<string> | null = null;
  let searchSequence = 0;

  async function queryPagefind(value: string) {
    const sequence = ++searchSequence;
    if (value.length < 2) {
      pagefindMatches = null;
      applyFilters();
      return;
    }
    try {
      // Pagefind is created after the Astro build. Development falls back to card text.
      const pagefindPath = "/pagefind/pagefind.js";
      const pagefind = await import(/* @vite-ignore */ pagefindPath);
      const response = await pagefind.search(value);
      const results = await Promise.all(response.results.map((result: { data: () => Promise<{ url: string; meta?: { slug?: string } }> }) => result.data()));
      if (sequence !== searchSequence) return;
      pagefindMatches = new Set(results.map((result) => result.meta?.slug ?? result.url.match(/#resource-([^/]+)$/)?.[1]).filter(Boolean));
    } catch {
      pagefindMatches = null;
    }
    applyFilters();
  }

  function applyFilters() {
    const query = search?.value.trim().toLowerCase() ?? "";
    let visible = 0;
    cards.forEach((card) => {
      const textMatch = !query || pagefindMatches?.has(card.dataset.slug ?? "") || (!pagefindMatches && card.dataset.search?.includes(query));
      card.hidden = !textMatch;
      if (textMatch) visible += 1;
    });
    if (count) count.textContent = String(visible);
    if (empty) empty.hidden = visible !== 0;
    chips.forEach((chip) => chip.setAttribute("aria-pressed", String(chip.dataset.keyword?.toLowerCase() === query)));
  }

  search?.addEventListener("input", () => queryPagefind(search.value.trim()));
  chips.forEach((chip) => chip.addEventListener("click", () => {
    if (!search) return;
    const keyword = chip.dataset.keyword ?? "";
    search.value = search.value.trim().toLowerCase() === keyword.toLowerCase() ? "" : keyword;
    queryPagefind(search.value);
  }));
  document.addEventListener("keydown", (event) => {
    if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === "k") {
      event.preventDefault();
      search?.focus();
    }
  });
</script>
