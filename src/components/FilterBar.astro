---
import { Search } from "@lucide/astro";
import type { ResourceEntry } from "../lib/content";

interface Props { resources: ResourceEntry[] }
const { resources } = Astro.props;
const keywords = ["Codex", "Claude", "Agents", "Xcode", "Testing", "SwiftUI"];
---

<section class="filter-panel" aria-label="Search posts">
  <p class="filter-label">Search the collection</p>
  <div class="filter-row">
    <div class="search-input-wrap">
      <Search class="search-icon" size={20} stroke-width={2.2} aria-hidden="true" />
      <input id="resource-search" type="search" placeholder="Search posts" autocomplete="off" aria-label="Search posts" />
    </div>
    <div class="keyword-chips" aria-label="Common searches">
      {keywords.map((keyword) => <button class="keyword-chip" type="button" data-keyword={keyword} aria-pressed="false">{keyword}</button>)}
    </div>
  </div>
  <p class="filter-status" aria-live="polite"><strong id="result-count">{resources.length}</strong> posts</p>
</section>

<script>
  const search = document.querySelector<HTMLInputElement>("#resource-search");
  const chips = [...document.querySelectorAll<HTMLButtonElement>("[data-keyword]")];
  const cards = [...document.querySelectorAll<HTMLElement>("[data-resource-card]")];
  const count = document.querySelector<HTMLElement>("#result-count");
  const empty = document.querySelector<HTMLElement>("#empty-state");
  let pagefindMatches: Set<string> | null = null;
  let searchSequence = 0;

  function termsFrom(value: string) {
    return value.split(",").map((term) => term.trim()).filter(Boolean);
  }

  async function queryPagefind(value: string) {
    const sequence = ++searchSequence;
    const terms = termsFrom(value).filter((term) => term.length >= 2);
    if (terms.length === 0) {
      pagefindMatches = null;
      applyFilters();
      return;
    }
    try {
      // Pagefind is created after the Astro build. Development falls back to card text.
      const pagefindPath = "/pagefind/pagefind.js";
      const pagefind = await import(/* @vite-ignore */ pagefindPath);
      const responses = await Promise.all(terms.map((term) => pagefind.search(term)));
      const results = await Promise.all(responses.flatMap((response) => response.results).map((result: { data: () => Promise<{ url: string; meta?: { slug?: string } }> }) => result.data()));
      if (sequence !== searchSequence) return;
      const slugs = results.map((result) => result.meta?.slug ?? result.url.match(/#resource-([^/]+)$/)?.[1]).filter((slug): slug is string => Boolean(slug));
      pagefindMatches = new Set(slugs);
    } catch {
      pagefindMatches = null;
    }
    applyFilters();
  }

  function applyFilters() {
    const terms = termsFrom(search?.value ?? "").map((term) => term.toLowerCase());
    let visible = 0;
    cards.forEach((card) => {
      const textMatch = terms.length === 0 || pagefindMatches?.has(card.dataset.slug ?? "") || (!pagefindMatches && terms.some((term) => card.dataset.search?.includes(term)));
      card.hidden = !textMatch;
      if (textMatch) visible += 1;
    });
    if (count) count.textContent = String(visible);
    if (empty) empty.hidden = visible !== 0;
    const selected = new Set(terms);
    chips.forEach((chip) => chip.setAttribute("aria-pressed", String(selected.has(chip.dataset.keyword?.toLowerCase() ?? ""))));
  }

  search?.addEventListener("input", () => queryPagefind(search.value.trim()));
  chips.forEach((chip) => chip.addEventListener("click", () => {
    if (!search) return;
    const keyword = chip.dataset.keyword ?? "";
    const terms = termsFrom(search.value);
    const selectedIndex = terms.findIndex((term) => term.toLowerCase() === keyword.toLowerCase());
    if (selectedIndex >= 0) terms.splice(selectedIndex, 1);
    else terms.push(keyword);
    search.value = terms.join(",");
    queryPagefind(search.value);
  }));
  document.addEventListener("keydown", (event) => {
    if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === "k") {
      event.preventDefault();
      search?.focus();
    }
  });
</script>
